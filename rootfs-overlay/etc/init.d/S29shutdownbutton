#!/bin/sh
# Start independently of the emulator and do not delay boot for input discovery.

DAEMON=/usr/local/sbin/shutdown-button.py
PIDFILE=/run/shutdown-button.pid

case "$1" in
    start)
        echo "Starting QBone shutdown-button monitor"
        start-stop-daemon -S -q -o -b -m -p "$PIDFILE" \
            -x /usr/bin/python3 -- "$DAEMON"
        ;;
    stop)
        echo "Stopping QBone shutdown-button monitor"
        start-stop-daemon -K -q -o -p "$PIDFILE" -x /usr/bin/python3
        ;;
    restart)
        "$0" stop
        sleep 1
        "$0" start
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
        ;;
esac

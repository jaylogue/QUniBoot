# /etc/inittab
#

# Startup
::sysinit:/bin/mount -t proc proc /proc
::sysinit:/sbin/e2fsck -p /dev/mmcblk0p2
::sysinit:/bin/mount -o remount,rw,noatime /
::sysinit:/bin/mkdir -p /dev/pts /dev/shm
::sysinit:/sbin/fsck -AsRT
::sysinit:/bin/mount -a
::sysinit:/bin/mkdir -p /run/lock/subsys
null::sysinit:/bin/ln -sf /proc/self/fd /dev/fd
null::sysinit:/bin/ln -sf /proc/self/fd/0 /dev/stdin
null::sysinit:/bin/ln -sf /proc/self/fd/1 /dev/stdout
null::sysinit:/bin/ln -sf /proc/self/fd/2 /dev/stderr
::sysinit:/etc/init.d/rcS

# Shutdown
::shutdown:/etc/init.d/rcK
::shutdown:/bin/umount -a -r

# Auto-login as root on the console port (BeagleBone Black serial header)
console::respawn:/sbin/getty -L -n -l /usr/local/sbin/autologin.sh console 115200 xterm

# Auto-login as root on ttyS2 (UniBone/QBone UART2)
# Comment out this line to free UART2 for other uses.
ttyS2::respawn:/sbin/getty -L -n -l /usr/local/sbin/autologin.sh ttyS2 115200 xterm

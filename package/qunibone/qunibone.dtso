// Linux Device Tree Overlay for QUniBoot
// 

/dts-v1/;
/plugin/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>

/ {
   compatible = "ti,beaglebone", "ti,beaglebone-black";

   part-number = "QUniBone";

   exclusive-use =

         // SW[0..3] input on regular GPIO
         "P8.23", "P8.22", "P8.3", "P8.4",

         // BUTTON input on regular GPIO
         "P8.12",

         // LED[0..3] output on regular GPIO
         "P8.25", "P8.24", "P8.5", "P8.6",

         // Driver & Register output enable output on regular GPIO
         "P8.11", "P8.16",

         // PRU0 REG_DATOUT[0..7] outputs
         "P9.31", "P9.29", "P9.30", "P9.28", "P9.27", "P9.25",

         // PRU1 REG_DATIN[0..7] inputs
         "P8.45", "P8.46", "P8.43", "P8.44", "P8.41", "P8.42", "P8.39", "P8.40",

         // PRU1 REG_ADR[0..2], REG_WRITE outputs
         "P8.27", "P8.29", "P8.28", "P8.30",

         // PRU1 Debugging output r30 pin 12  // ,13
         "P8.21",

         // Assert constant level on eMMC CMD input
         "P8.20",

         "P9.26", // Pin UART1 RXD
         "P9.24", // Pin UART1 TXD
         "P9.22", // Pin UART2 RXD
         "P9.21", // Pin UART2 TXD

         "P9.11",  // GPIO0_30: QBone activity LED
         "P9.12",  // GPIO1_28: I2C panel reset

         "P8.9",    // GPIO2_5: Timer5 output

         // ip used
         "pru0", "pru1",
         "uart1", "uart2"  // UARTs necessary here?
         ;

   // Configure the pinmux
   //
   // NOTE: Some of these pin configurations conflict with pins that are used to
   // talk to the on-board eMMC. Specifically:
   //
   //    GPIO1_0  - P8.25 - MMC1_DAT0 - LED0
   //    GPIO1_30 - P8.21 - MMC1_CLK  - PRU1_12 (DEBUG PIN 0)
   //    GPIO1_31 - P8.20 - MMC1_CMD  - PRU1_13 (DEBUG PIN 1)
   //
   // Ideally, to properly avoid any possibility of conflict, the eMMC chip itself
   // should be placed into inactive mode, by sending it a MMC_GO_INACTIVE_STATE/CMD15
   // command. This would need to be handled by code that runs before the pinmux is
   // configured; it cannot be accomplished solely within the DTS itself. Currently,
   // no such code exists.
   //
   // However, as long as GPIO1_31/MMC1_CMD remains low, any activity on the other
   // pins will not trigger bad behavior in the eMMC. Conventiently, the code in
   // the QUniBone PRU that uses GPIO1_31 is not enabled by default.
   //
   // In any case, the linux driver for the eMMC must be disabled (see below) to
   // avoid conflict with the pin assignments here, thus rendering the eMMC inaccessible
   // from linux.
   //
   fragment@0 {
      target = <&am33xx_pinmux>;
      __overlay__ {

         // Bind the pinctrl state for the general (non-PRU) GPIO pins to
         // the pinmux node itself.  This has the effect of forcing the pins
         // to be configured during boot, even though they are not referenced
         // by any other device.
         pinctrl-names = "default";
         pinctrl-0 = <&gpio_pins>;

         // General (non-PRU) GPIO pins
         gpio_pins: pinmux_gpio_pins {
            pinctrl-single,pins = <

               0x010 0x2f // SW0 input on P8.23: gpio1_4, rx, no pull up/dn, mode=7
               0x014 0x2f // SW1 input on P8.22: gpio1_5, rx, no pull up/dn, mode=7
               0x018 0x2f // SW2 input on P8.3: gpio1_6, rx, no pull up/dn, mode=7
               0x01c 0x2f // SW3 input on P8.4: gpio1_7, rx, no pull up/dn, mode=7
               0x030 0x2f // BUTTON input on P8.12: gpio1_12, rx, no pull up/dn, mode=7

               0x000 0x07 // LED0 output on P8.25: gpio1_0, pulldown, mode=7
               0x004 0x07 // LED1 output on P8.24: gpio1_1, pulldown, mode=7
               0x008 0x07 // LED2 output on P8.05: gpio1_2, pulldown, mode=7
               0x00c 0x07 // LED3 output on P8.06: gpio1_3, pulldown, mode=7
               0x038 0x17 // REG_ENABLE output on P8.16: gpio1_14, pullup, mode=7
               0x034 0x17 // BUS_ENABLE output on P8.11: gpio1_13, pullup, mode=7

               0x180 0x30 // UART1 RXD on P9.26, receiver, pullup, mode=0=UART1
               0x184 0x10 // UART1 TXD on P9.24, xmitter, pullup, mode=0=UART1
               0x150 0x31 // UART2 RXD on P9.22, receiver, pullup, mode=1=UART2
               0x154 0x11 // UART2 TXD on P9.21, xmitter, pullup, mode=1=UART2

               0x070 0x07 // Activity LED on P9.11 (later PCBs only): gpio0_30, pulldown, mode=7

               0x078 0x17 // I2C panel reset on P9.12: gpio1_28, pullup, mode=7

               0x09c 0x02 // 50/60Hz generation, Timer5 output on P8.09, pulldown, mode=2
            >;
         };

         // PRU GPIO pins
         pru_pru_pins: pinmux_pru_pru_pins {
            pinctrl-single,pins = <
               0x190 0x15 // PRU0 REG_DATOUT_0 on P9.31: pr1_pru0_pru_r30_0, fast, pullup, mode=5
               0x194 0x15 // PRU0 REG_DATOUT_1 on P9.29: pr1_pru0_pru_r30_1, fast, pullup, mode=5
               0x198 0x15 // PRU0 REG_DATOUT_2 on P9.30: pr1_pru0_pru_r30_2, fast, pullup, mode=5
               0x19c 0x15 // PRU0 REG_DATOUT_3 on P9.28: pr1_pru0_pru_r30_3, fast, pullup, mode=5
               0x1a0 0x15 // PRU0 REG_DATOUT_4 on P9.42: pr1_pru0_pru_r30_4, fast, pullup, mode=5
               0x1a4 0x15 // PRU0 REG_DATOUT_5 on P9.27: pr1_pru0_pru_r30_5, fast, pullup, mode=5
               0x1a8 0x15 // PRU0 REG_DATOUT_6 on P9.41: pr1_pru0_pru_r30_6, fast, pullup, mode=5
               0x1ac 0x15 // PRU0 REG_DATOUT_7 on P9.25: pr1_pru0_pru_r30_7, fast, pullup, mode=5
               0x164 0x2f // P9.42 REG_DATOUT_4 tied to GPIO0_7: GPIO tristate! input, no pull up/dn, mode=7
               0x1b4 0x2f // P9.41 REG_DATOUT_6 tied to GPIO0_20: GPIO tristate! input, no pull up/dn, mode=7

               0x0a0 0x2e // PRU1 REG_DATIN_0 on P8.45: pr1_pru1_pru_r31_0, fast, rx, no pulldown, mode=6
               0x0a4 0x2e // PRU1 REG_DATIN_1 on P8.46: pr1_pru1_pru_r31_1, fast, rx, no pulldown, mode=6
               0x0a8 0x2e // PRU1 REG_DATIN_2 on P8.43: pr1_pru1_pru_r31_2, fast, rx, no pulldown, mode=6
               0x0ac 0x2e // PRU1 REG_DATIN_3 on P8.44: pr1_pru1_pru_r31_3, fast, rx, no pulldown, mode=6
               0x0b0 0x2e // PRU1 REG_DATIN_4 on P8.41: pr1_pru1_pru_r31_4, fast, rx, no pulldown, mode=6
               0x0b4 0x2e // PRU1 REG_DATIN_5 on P8.42: pr1_pru1_pru_r31_5, fast, rx, no pulldown, mode=6
               0x0b8 0x2e // PRU1 REG_DATIN_6 on P8.39: pr1_pru1_pru_r31_6, fast, rx, no pulldown, mode=6
               0x0bc 0x2e // PRU1 REG_DATIN_7 on P8.40: pr1_pru1_pru_r31_7, fast, rx, no pulldown, mode=6
               0x0e0 0x05 // PRU1 REG_ADR_0 on P8.27: pr1_pru1_pru_r30_8, fast, output, pulldown, mode=5
               0x0e4 0x05 // PRU1 REG_ADR_1 on P8.29: pr1_pru1_pru_r30_9, fast, output, pulldown, mode=5
               0x0e8 0x05 // PRU1 REG_ADR_2 on P8.28: pr1_pru1_pru_r30_10, fast, output, pulldown, mode=5
               0x0ec 0x15 // PRU1 REG_WRITE on P8.30: pr1_pru1_pru_r30_11, fast, output, pullup, mode=5
               0x080 0x05 // PRU1 PRU1_12 (DEBUG PIN 0) on P8.21: pr1_pru1_pru_r30_12, fast, output, pulldown, mode=5
               0x084 0x05 // PRU1 PRU1_13 (DEBUG PIN 1) on P8.20: pr1_pru1_pru_r30_13, fast, output, pulldown, mode=5
            >;
         };
      };
   };

   // Enable UIO PRUSS
   // This binds the UIO PRUSS driver to the existing pruss@0 node and 
   // adds the config properties needed by the driver. It also forces
   // configuration of the PRU GPIO pins via the pinmux.
   fragment@1 {
      target = <&pruss>;
      __overlay__ {
         compatible = "ti,pruss-v2";
         ti,pintc-offset = <0x20000>;
         interrupt-parent = <&intc>;
         interrupts = <20 21 22 23 24 25 26 27>;
         pinctrl-names = "default";
         pinctrl-0 = <&pru_pru_pins>;
      };
   };

   // Enable UART1
   fragment@2 {
      target = <&uart1>;
      __overlay__ {
               status          = "okay";
      };
    };

   // Enable UART2
   fragment@3 {
      target = <&uart2>;
      __overlay__ {
               status          = "okay";
      };
   };

   // Disable McASP to avoid conflict with pins used by QUniBone
   fragment@4 {
      target = <&mcasp0>;
      __overlay__ {
         status = "disabled";
      };
   };

   // Disable the LCD controller to avoid conflict pins used by QUniBone
   fragment@5 {
      target = <&lcdc>;
      __overlay__ {
         status = "disabled";
      };
   };

   // Disable HDMI encoder node
   fragment@6 {
      target = <&tda19988>;
      __overlay__ {
         status = "disabled";
      };
   };

   // Disable the driver for the on-board eMMC
   fragment@7 {
      target = <&mmc2>;
      __overlay__ {
         status = "disabled";
      };
   };

   // Disable scanning for secondary cape EEPROMs
   // This reduces boots time by a small amount.
   fragment@8 {
      target = <&i2c2>;
      __overlay__ {
         clock-frequency = <400000>;

         cape_eeprom1: cape_eeprom1@55 {
            status = "disabled";
         };
         cape_eeprom2: cape_eeprom2@56 {
            status = "disabled";
         };
         cape_eeprom3: cape_eeprom3@57 {
            status = "disabled";
         };
      };
   };

   // Disable sound device
   fragment@9 {
      target-path = "/";
      __overlay__ {
         sound {
            compatible = "disabled";
         };
      };
   };
   
   // Enable access to QUniBone LEDs via gpio-leds driver.
   fragment@10 {
      target-path = "/";
      __overlay__ {
         qunibone_leds {
               compatible = "gpio-leds";

               qunibone_led0 {
                  label = "qunibone:test_led0";
                  gpios = <&gpio1 0 GPIO_ACTIVE_LOW>;
                  default-state = "off";
               };
               qunibone_led1 {
                  label = "qunibone:test_led1";
                  gpios = <&gpio1 1 GPIO_ACTIVE_LOW>;
                  default-state = "off";
               };
               qunibone_led2 {
                  label = "qunibone:test_led2";
                  gpios = <&gpio1 2 GPIO_ACTIVE_LOW>;
                  default-state = "off";
               };
               qunibone_led3 {
                  label = "qunibone:test_led3";
                  gpios = <&gpio1 3 GPIO_ACTIVE_LOW>;
                  default-state = "off";
               };
               qunibone_led4 {
                  label = "qunibone:bus_activity_led";
                  gpios = <&gpio0 30 GPIO_ACTIVE_LOW>;
                  default-state = "off";
               };
         };
      };
   };
};

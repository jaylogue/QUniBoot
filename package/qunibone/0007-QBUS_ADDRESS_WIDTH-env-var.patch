From d7692f500cc348f9b3cabeb0eda6166786772d9e Mon Sep 17 00:00:00 2001
From: Jay Logue <jay.logue@gmail.com>
Date: Sun, 6 Sep 2026 12:32:19 -0700
Subject: [PATCH] Read default value for QBUS address width from
 QBUS_ADDRESS_WIDTH environment variable

---
 10.03_app_demo/2_src/application.cpp | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/10.03_app_demo/2_src/application.cpp b/10.03_app_demo/2_src/application.cpp
index 4ce000e..6d908d3 100644
--- a/10.03_app_demo/2_src/application.cpp
+++ b/10.03_app_demo/2_src/application.cpp
@@ -175,7 +175,12 @@ void application_c::parse_commandline(int argc, char **argv)
                          "Lines are processed as if typed in.", "testseq",
                          "read commands from file \"testseq\" and execute line by line", "", "");
 #if defined(QBUS)
-    getopt_parser.define("aw", "addresswidth", "addresswidth", "", "",
+    std::string awDefault;
+    const char *envVal = getenv("QBUS_ADDRESS_WIDTH");
+    if (envVal != NULL) {
+        awDefault = envVal;
+    }
+    getopt_parser.define("aw", "addresswidth", "addresswidth", "", awDefault,
                          "Mandatory address width of QBUS CPU: 16, 18, 22.\nCan not be auto-probed from backplane address width.", "",
                          "", "", "");
 #endif
-- 
